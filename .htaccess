Options -Indexes
<FilesMatch "(?i)^(config|function|botapi|request|verification|security|report_setup|table|admin|panels|keyboard|jdf|install)\.(php|sh)$|^\.(env|git|ht)|\.(bak|old|orig|sql|log|ini|lock|zip|json|txt|md|sh)$">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
<Files "*.txt">
    Require all denied
</Files>
<Files "*.json">
    Require all denied
</Files>
<Files "*.sql">
    Require all denied
</Files>
<Files "*.zip">
    Require all denied
</Files>
